    {
        "id": "fn_format_map",
        "type": "function",
        "z": "thermal_monitoring_flow",
        "name": "Format Map Data",
        "func": "var data = Array.isArray(msg.payload) ? msg.payload[0] : msg.payload;\nvar lat = parseFloat(data.lat || 0.0);\nvar lon = parseFloat(data.lon || data.lng || 0.0);\n\nif (lat === 0.0 || lon === 0.0) return null;\n\nmsg.payload = {\n    name: \"Sensor Node 01\",\n    lat: lat,\n    lon: lon,\n    value: parseFloat(data.fusedTemp || data.temp || 0.0),\n    layer: \"Heatmap\"\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 540,
        "y": 410,
        "wires": [
