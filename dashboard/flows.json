    {
        "id": "ui_watchdog_template",
        "type": "ui_template",
        "z": "thermal_monitoring_flow",
        "group": "ui_grp_boxes",
        "name": "template",
        "order": 0,
        "width": "12",
        "height": "2",
        "format": "<div style=\"background-color: {{connected ? '#064e3b' : '#450a0a'}}; border: 1px solid {{connected ? '#059669' : '#dc2626'}}; border-radius: 8px; padding: 12px 20px; display: flex; align-items: center; justify-content: space-between; color: #ffffff; font-family: monospace; transition: all 0.3s ease;\">\n    <div style=\"display: flex; align-items: center; gap: 12px;\">\n        <span style=\"font-weight: bold; font-size: 16px;\">NODE01</span>\n        <span style=\"background: rgba(255,255,255,0.15); padding: 3px 8px; border-radius: 4px; font-size: 12px;\">\n            {{connected ? 'CONNECTED / TRANSMITTING' : 'DISCONNECTED / NO SIGNAL'}}\n        </span>\n    </div>\n    <div style=\"display: flex; align-items: center; gap: 15px;\">\n        <span ng-if=\"connected\" style=\"font-size: 18px; font-weight: bold;\">{{temp}} °C</span>\n        <span style=\"display: flex; align-items: center; gap: 6px; font-weight: bold; color: {{connected ? '#34d399' : '#f87171'}};\">\n            <span style=\"height: 10px; width: 10px; background-color: {{connected ? '#34d399' : '#f87171'}}; border-radius: 50%; display: inline-block;\"></span>\n            {{connected ? 'ONLINE' : 'OFFLINE'}}\n        </span>\n    </div>\n</div>\n\n<script>\n(function(scope) {\n    var timeoutTimer = null;\n    var TIMEOUT_MS = 2000;\n    scope.connected = false;\n    scope.temp = '';\n\n    scope.$watch('msg', function(msg) {\n        if (!msg || msg.payload === undefined) return;\n        var raw = msg.payload;\n        var obj = Array.isArray(raw) ? raw[0] : raw;\n        if (typeof obj === 'object' && obj !== null) {\n            var t = parseFloat(obj.fusedTemp || obj.temp || obj.sensor1 || 25.0);\n            if (!isNaN(t)) scope.temp = t.toFixed(1);\n        } else if (typeof obj === 'number') {\n            scope.temp = obj.toFixed(1);\n        }\n        scope.connected = true;\n        if (timeoutTimer) clearTimeout(timeoutTimer);\n        timeoutTimer = setTimeout(function() {\n            scope.connected = false;\n            scope.temp = '';\n            scope.$apply();\n        }, TIMEOUT_MS);\n    });\n})(scope);\n</script>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 850,
        "y": 810,
        "wires": [[]]
    },
    {
        "id": "fn_idw_heatmap",
        "type": "function",
        "z": "thermal_monitoring_flow",
        "name": "IDW Heatmap Estimator",
        "func": "var data = Array.isArray(msg.payload) ? msg.payload[0] : msg.payload;\nmsg.payload = {\n    lat: parseFloat(data.lat || 0.0),\n    lng: parseFloat(data.lon || data.lng || 0.0),\n    count: parseFloat(data.fusedTemp || data.temp || 0.0)\n};\nreturn msg;",
