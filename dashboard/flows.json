    {
        "id": "fn_format_history",
        "type": "function",
        "z": "thermal_monitoring_flow",
        "name": "Format History",
        "func": "var incoming = msg.payload;\nif (typeof incoming === 'string') {\n    try { incoming = JSON.parse(incoming); } catch(e) {}\n}\nvar obj = Array.isArray(incoming) ? incoming[0] : incoming;\nvar now = Date.now();\n\nvar s1Temp = parseFloat(obj.sensor1 || obj.temp1 || 0.0);\nvar s2Temp = parseFloat(obj.sensor2 || obj.temp2 || 0.0);\nvar fused  = parseFloat(obj.fusedTemp || obj.temp || 0.0);\n\nreturn [\n    { payload: s1Temp, topic: \"Sensor 1\", time: now },\n    { payload: s2Temp, topic: \"Sensor 2\", time: now },\n    { payload: fused,  topic: \"Fused Temperature\", time: now }\n];",
        "outputs": 3,
        "noerr": 0,
        "x": 530,
        "y": 300,
        "wires": [
            [
                "chart_sensor1"
            ],
            [
                "chart_sensor2"
            ],
            [
                "chart_fused"
            ]
        ]
    },
