    {
        "id": "fn_temp_alarm",
        "type": "function",
        "z": "thermal_monitoring_flow",
        "name": "Temperature Alarm",
        "func": "var data = Array.isArray(msg.payload) ? msg.payload[0] : msg.payload;\nvar temp = parseFloat(data.fusedTemp || data.temp || 0.0);\n\nif (temp > 40.0) {\n    var alarmMsg = { payload: \"HIGH TEMPERATURE ALARM: \" + temp + \" °C\", temp: temp };\n    return [alarmMsg, alarmMsg, alarmMsg];\n}\nreturn [null, null, null];",
        "outputs": 3,
        "noerr": 0,
        "x": 540,
        "y": 550,
        "wires": [
            [
                "out_alarm_notif"
            ],
            [
                "ui_alarm_audio"
            ],
            [
                "ui_alarm_banner"
            ]
        ]
    },
